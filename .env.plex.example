SERVER_IP=192.168.1.10
TZ=Europe/Warsaw

PLEX_MEDIA_PATH=/srv/media
PLEX_CONFIG_PATH=./data/plex
PLEX_TRANSCODE_PATH=./data/transcode
PLEX_UID=1000
PLEX_GID=1000
PLEX_HOSTNAME=plex
PLEX_IMAGE=plexinc/pms-docker:latest
PLEX_CLAIM=

FRIWATCH_PORT=3000
FRIWATCH_IMAGE=ghcr.io/dejniel/friwatch:latest
# Set to the existing data volume when upgrading an earlier installation.
FRIWATCH_DATA_VOLUME=friwatch-data
DISABLE_WATCH_TOGETHER=false
DISABLE_REQUEST_LOGGING=false
TLS_SELF_SIGNED=false
TLS_COMMON_NAME=localhost
TLS_SUBJECT_ALT_NAME=DNS:localhost
